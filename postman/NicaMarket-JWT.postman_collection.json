              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"operador\",\n    \"password\": \"Operador123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3. Login con contraseña incorrecta",
          "event": [
            {
