{
  "info": {
    "name": "NicaMarket – JWT",
    "description": "Práctica guiada n.º 9: Seguridad con Spring Security y JWT (gestion-productos). Ejecutar en orden: los logins guardan los tokens en variables de la colección. El archivo no contiene tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Pruebas de la guía (1-8)",
      "item": [
        {
          "name": "1. Saludo público (sin token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"1. Saludo público (sin token): responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publico/saludo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "publico",
                "saludo"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "2. Login ADMIN (credenciales válidas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"2. Login ADMIN (credenciales válidas): responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2b. Login USER (operador)",
          "event": [
